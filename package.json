{
  "name": "playwright",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "ui-mode": "npx playwright test --ui",
    "test:ui:regression": "npm run test -- --project=sales-portal-ui --grep @regression",
    "test:ui:smoke": "npm run test -- --project=sales-portal-ui --grep @smoke",
    "test:ui:ui": "npm run test -- --project=sales-portal-ui --grep @ui",
    "test:all": "npm run test -- --project=sales-portal-ui",
    "test:api:regression": "npm run test -- --project=sales-portal-api --grep @regression",
    "test:api:smoke": "npm run test -- --project=sales-portal-api --grep @smoke",
    "test:api:api": "npm run test -- --project=sales-portal-api --grep @api",
    "html-report-open": "npx playwright show-report",
    "allure-report": "allure generate allure-results -o allure-report --clean",
    "allure-report-open": "npm run allure-report && allure open allure-report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rapolinka/PlayWright.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
